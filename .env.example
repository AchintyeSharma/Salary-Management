# PostgreSQL container settings (local Docker Compose)
POSTGRES_DB=acme_salary
POSTGRES_USER=acme_admin
POSTGRES_PASSWORD=change_me_admin_password

# Restricted runtime application DB role (SELECT/INSERT only on salary_revisions)
APP_DB_USER=acme_app
APP_DB_PASSWORD=change_me_app_password

# Database connection strings
# MIGRATION_DATABASE_URL uses the owner role for Prisma Migrate, seed, and HR account provisioning.
MIGRATION_DATABASE_URL=postgresql://acme_admin:change_me_admin_password@localhost:5432/acme_salary?schema=public
# DATABASE_URL uses the restricted runtime role for the Express API.
DATABASE_URL=postgresql://acme_app:change_me_app_password@localhost:5432/acme_salary?schema=public
# TEST_DATABASE_URL is used by automated PostgreSQL integration tests (separate disposable DB).
TEST_DATABASE_URL=postgresql://acme_admin:change_me_admin_password@localhost:5432/acme_test?schema=public
TEST_APP_DATABASE_URL=postgresql://acme_app:change_me_app_password@localhost:5432/acme_test?schema=public

# Express API & single-origin web server
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=8

# Ask about pay interpreter ("deterministic" by default; live provider is optional)
PAY_INTERPRETER_MODE=deterministic

# One-time HR demo account provisioning (keep real hosted values outside Git)
HR_DEMO_EMAIL=hr.manager@acme.example
HR_DEMO_NAME=ACME HR Manager
HR_DEMO_PASSWORD=change_me_hr_demo_password
